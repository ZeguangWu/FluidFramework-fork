{
	"extends": "../../../../common/build/build-common/tsconfig.node20.json",
	"compilerOptions": {
		"rootDir": "..",
		"outDir": "./lib",
		"types": ["react"],
		// The harness is only bundled by webpack (ts-loader transpileOnly), which needs ES module output.
		"module": "esnext",
		"moduleResolution": "bundler",
		"exactOptionalPropertyTypes": false,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"incremental": false,
		"sourceMap": false,
		"inlineSources": false,
	},
	"include": ["./*.tsx", "../src/styles.d.ts"],
}
